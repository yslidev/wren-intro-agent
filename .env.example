# --- Which iMessage transport to run ---
# sim    : in-memory phones + web simulator at /sim (default, no accounts needed)
# linq   : Linq Partner API (cloud iMessage lines, webhooks)  https://docs.linqapp.com
# photon : Photon iMessage Kit on a Mac you own (reads ~/Library/Messages/chat.db)
TRANSPORT=sim

# Claude. Leave unset to run the deterministic fallback brain (free, good for demos/tests).
ANTHROPIC_API_KEY=
WREN_MODEL=claude-opus-5-5

# Linq
LINQ_API_TOKEN=
LINQ_FROM_NUMBER=+1XXXXXXXXXX
LINQ_WEBHOOK_SECRET=whsec_...
LINQ_GROUP_ICON_URL=

# Server
PORT=8787
# Protects /api/kickoff, /api/match, /api/reset when set. Sim UI sends it as a header if you paste it in.
ADMIN_TOKEN=
# Demo pacing (ms): how long Wren "waits" before proposing a match / following up after a call.
MATCH_DELAY_MS=4000
FOLLOWUP_DELAY_MS=15000
